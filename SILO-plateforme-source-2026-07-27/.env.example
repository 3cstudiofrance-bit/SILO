# ============================================================
# 3C STUDIO — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Base de données (Drizzle + PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/3c_studio

# --- Clerk (Auth frontend) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Supabase (DB + Third-Party Auth Clerk + Realtime + Storage) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Stripe (Phase 3 : Paiements) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_RESTRICTED_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (Phase 4 : Emails transactionnels) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=3cstudio@votre-domaine.fr

# --- LiveKit (Phase 5 : Appels vidéo) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-secret
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Twilio (SMS, voix et callbacks) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-api-key-secret
# Utilisé uniquement pour valider X-Twilio-Signature.
TWILIO_AUTH_TOKEN=your-account-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WEBHOOK_BASE_URL=https://api.silovisuel.com

# --- Tally (serveur uniquement, jamais préfixer par VITE_) ---
TALLY_API_KEY=tly_...
TALLY_CLIENT_FORM_ID=rjWGb2
TALLY_PARTNER_FORM_ID=ob1v7x

# --- OpenSign (Phase 6 : Signature électronique) ---
OPENSIGN_API_KEY=your-opensign-api-key
OPENSIGN_BASE_URL=https://api.opensignlabs.com

# --- Liveblocks (Phase 7 : Éditeur collaboratif) ---
LIVEBLOCKS_SECRET_KEY=sk_...
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_...

# --- Firebase Cloud Messaging (Phase 8 : Push notifications) ---
FIREBASE_API_KEY=AIza...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123
FIREBASE_VAPID_KEY=BNtG...

# --- App ---
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production silovisuel.com :
# NODE_ENV=production
# APP_BASE_URL=https://silovisuel.com
# CORS_ALLOWED_ORIGINS=https://silovisuel.com,https://www.silovisuel.com
